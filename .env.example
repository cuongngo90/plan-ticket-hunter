# Copy thành .env.local rồi điền giá trị. .env.local nằm trong .gitignore — KHÔNG điền secret vào file này.

# --- Database --------------------------------------------------------------
# Neon: Dashboard → Connect → "Pooled connection" (host có "-pooler"), giữ ?sslmode=require
# Dev nên dùng branch riêng (Neon → Branches → Create branch "dev"), KHÔNG dùng branch production.
# Local Docker: postgres://postgres:postgres@localhost:5432/sanve
DATABASE_URL=
# Database cho integration test (npm run test:int). Bỏ trống thì test tự skip.
TEST_DATABASE_URL=

# --- Provider --------------------------------------------------------------
# 1 = dùng MockProvider, không gọi API thật (bắt buộc cho tới slice 3)
MOCK_PROVIDER=
# Tuyến luôn có deal khi dùng mock, cách nhau bằng dấu phẩy (vd. SGN-HAN) — để thử alert
MOCK_FORCE_DEAL=
# Slice 3 trở đi
TRAVELPAYOUTS_TOKEN=

# --- Cron ------------------------------------------------------------------
# Chuỗi ngẫu nhiên ≥ 16 ký tự; cron-job.org gửi trong header x-cron-secret
CRON_SECRET=

# --- Telegram --------------------------------------------------------------
# Nhắn @BotFather → /newbot → lấy token
TELEGRAM_BOT_TOKEN=
# Chat id của bạn: nhắn 1 tin cho bot rồi chạy `npm run telegram:chat-id`
# Dùng cho vertical slice #0, tới slice 8 thì user tự liên kết Telegram
TELEGRAM_CHAT_ID=
# Slice 8 (webhook)
TELEGRAM_WEBHOOK_SECRET=

# --- Auth (slice 2) --------------------------------------------------------
# Email được phép đăng nhập, cách nhau bằng dấu phẩy
ALLOWED_EMAILS=
# Sinh bằng: npx auth secret
AUTH_SECRET=
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
