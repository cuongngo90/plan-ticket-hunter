{
  "name": "san-ve",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed:airports": "tsx --env-file=.env.local scripts/seed-airports.ts",
    "db:check": "tsx --env-file=.env.local scripts/check-db.ts",
    "dev:watch": "tsx --env-file=.env.local scripts/dev-create-watch.ts",
    "telegram:chat-id": "tsx --env-file=.env.local scripts/telegram-chat-id.ts",
    "test:int": "vitest run --config vitest.int.config.mts",
    "spike": "node --env-file=spike/.env spike/providers.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "16.3.5",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
